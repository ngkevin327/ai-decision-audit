{
  "name": "@audit-trail/sdk",
  "version": "0.1.0",
  "description": "Official Node.js SDK for the AI Audit Trail platform",
  "license": "MIT",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./integrations/openai": {
      "types": "./dist/integrations/openai.d.ts",
      "default": "./dist/integrations/openai.js"
    },
    "./integrations/anthropic": {
      "types": "./dist/integrations/anthropic.d.ts",
      "default": "./dist/integrations/anthropic.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').writeFileSync('tsconfig.json',JSON.stringify({compilerOptions:{target:'ES2021',module:'commonjs',declaration:true,outDir:'dist',rootDir:'src',strict:true,esModuleInterop:true,skipLibCheck:true,forceConsistentCasingInFileNames:true},include:['src/**/*'],exclude:['node_modules','dist']}));\" && tsc -p tsconfig.json",
    "lint": "pnpm typecheck",
    "test": "jest",
    "typecheck": "node -e \"require('fs').writeFileSync('tsconfig.json',JSON.stringify({compilerOptions:{target:'ES2021',module:'commonjs',declaration:true,outDir:'dist',rootDir:'src',strict:true,esModuleInterop:true,skipLibCheck:true,forceConsistentCasingInFileNames:true},include:['src/**/*'],exclude:['node_modules','dist','test']}));\" && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@audit-trail/schema": "workspace:*"
  },
  "devDependencies": {
    "@audit-trail/eslint-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=20"
  }
}
