{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit-trail.dev/schemas/v1/actor.schema.json",
  "title": "Actor",
  "type": "object",
  "additionalProperties": false,
  "required": ["actor_id", "actor_type"],
  "properties": {
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "actor_type": {
      "type": "string",
      "enum": ["user", "service", "agent", "system"]
    },
    "display_name": {
      "type": "string",
      "maxLength": 256
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
