{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit-trail.dev/schemas/v1/event.schema.json",
  "title": "TraceEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "type", "occurred_at", "span_id"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "type": {
      "type": "string",
      "enum": ["prompt", "completion", "tool_call", "retrieval", "approval", "custom"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "span_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "prompt" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["messages"],
            "properties": {
              "messages": { "type": "array", "minItems": 1 },
              "model": { "type": "string" },
              "temperature": { "type": "number" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "completion" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["content"],
            "properties": {
              "content": { "type": "string" },
              "model": { "type": "string" },
              "token_usage": {
                "type": "object",
                "properties": {
                  "prompt_tokens": { "type": "integer" },
                  "completion_tokens": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool_call" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["tool_name"],
            "properties": {
              "tool_name": { "type": "string" },
              "input": { "type": "object" },
              "output": { "type": "object" },
              "duration_ms": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "retrieval" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["chunks"],
            "properties": {
              "query": { "type": "string" },
              "chunks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["chunk_id", "content"],
                  "properties": {
                    "chunk_id": { "type": "string" },
                    "content": { "type": "string" },
                    "score": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "approval" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["decision"],
            "properties": {
              "decision": { "type": "string", "enum": ["approved", "rejected", "escalated"] },
              "reason": { "type": "string" },
              "approver_id": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "custom" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "data": { "type": "object" }
            }
          }
        }
      }
    }
  ]
}
