# Copy to apps/web/.env.local (bootstrap also writes VITE_DEFAULT_ORG_ID)

VITE_API_BASE_URL=http://localhost:3100

# Clerk — required for sign-in flow (must match API CLERK_SECRET_KEY pair)
VITE_CLERK_PUBLISHABLE_KEY=

# Set by pnpm bootstrap:local (used when linking Clerk user to local org)
# VITE_DEFAULT_ORG_ID=

# Dev fallback only when VITE_CLERK_PUBLISHABLE_KEY is empty
# VITE_DEV_USER_ID=local_dev_user
