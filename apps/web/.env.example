# Copy to apps/web/.env.local (or run pnpm bootstrap:local)

# API base URL (default http://localhost:3000)
VITE_API_BASE_URL=http://localhost:3100

# Clerk — optional; leave empty to use dev mode without sign-in
VITE_CLERK_PUBLISHABLE_KEY=

# Set by bootstrap:local for trace explorer without Clerk
# VITE_DEFAULT_ORG_ID=
# VITE_DEV_USER_ID=local_dev_user
