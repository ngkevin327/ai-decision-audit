# API
NODE_ENV=development
# Use 3100 if 3000 is taken by another local app
PORT=3100

# PostgreSQL (docker compose)
DATABASE_URL=postgresql://audit:audit@localhost:15432/audit_trail

# Redis / BullMQ
REDIS_URL=redis://localhost:16379

# Object storage — minio (local) or s3 (staging/prod)
STORAGE_DRIVER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=19000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=audit-payloads

# Export package signing (local dev default; use a strong secret in staging/prod)
EXPORT_SIGNING_SECRET=dev-export-signing-secret

# Clerk (required for full local auth flow testing)
# Create an app at https://dashboard.clerk.com — use the same keys in apps/web/.env.local
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Populated by `pnpm bootstrap:local` (do not commit real keys)
# LOCAL_DEV_ORG_ID=
# LOCAL_DEV_PROJECT_ID=
# LOCAL_DEV_API_KEY=

# Email (optional locally; export/quota emails are skipped when unset)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@example.com

# Required when STORAGE_DRIVER=s3
# AWS_REGION=us-east-1
# S3_BUCKET=audit-trail-staging-payloads
