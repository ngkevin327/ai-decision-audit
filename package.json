{
  "name": "ai-audit-trail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev --filter=@audit-trail/api --filter=@audit-trail/web --filter=@audit-trail/worker",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "setup:local": "node scripts/setup-local.mjs",
    "deps:up": "docker compose up -d",
    "deps:down": "docker compose down",
    "deps:wait": "node scripts/wait-for-deps.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "db:migrate": "node scripts/with-root-env.mjs pnpm --filter @audit-trail/api exec prisma migrate deploy",
    "db:generate": "node scripts/with-root-env.mjs pnpm --filter @audit-trail/api exec prisma generate",
    "bootstrap:local": "node scripts/with-root-env.mjs pnpm exec tsx scripts/bootstrap-local-dev.ts",
    "seed:demo": "node scripts/with-root-env.mjs pnpm exec tsx scripts/seed-demo-traces.ts",
    "audit:deps": "pnpm audit --audit-level=moderate"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": []
    }
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript-eslint": "^8.18.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write"
  }
}
